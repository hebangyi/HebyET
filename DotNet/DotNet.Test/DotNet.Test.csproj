<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Hotfix\DotNet.Hotfix.csproj" />
      <ProjectReference Include="..\Model\DotNet.Model.csproj" />
      <ProjectReference Include="..\ThirdParty\DotNet.ThirdParty.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Box2DTest\Abstractions\" />
      <Folder Include="Box2DTest\Samples\" />
      <Folder Include="Box2DTest\Testbed\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="ImGui.NET" Version="1.91.0.1" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
      <PackageReference Include="OpenTK" Version="4.8.2" />
      <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
    </ItemGroup>


    <ItemGroup>
        <Content Include="Box2DTest\Testbed\Render\data\*.*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <Link>Render\data\%(Filename)%(Extension)</Link>
        </Content>
    </ItemGroup>

</Project>
